{
  "Users": {
    "Id": {
      "dataType": "Int32",
      "nullable": false
    },
    "Name": {
      "dataType": "String",
      "nullable": true,
      "maxLength": 100
    },
    "Email": {
      "dataType": "String",
      "nullable": true,
      "maxLength": 255
    },
    "UpdatedAt": {
      "dataType": "String",
      "format": "yyyyMMddHHmmssfff",
      "nullable": true
    }
  }
}
